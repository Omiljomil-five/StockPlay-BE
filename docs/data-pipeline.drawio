    </mxCell>

    <!-- Phase 3: API & Output -->
    <mxCell id="phase3-label" value="3. API &amp; Report Generation" style="text;html=1;fontSize=11;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#E65100;" vertex="1" parent="1">
