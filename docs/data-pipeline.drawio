<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="StockPlay - Data Pipeline" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1B2A4A;" vertex="1" parent="1">
      <mxGeometry x="200" y="5" width="400" height="35" as="geometry"/>
    </mxCell>

    <!-- Phase 1: Data Collection -->
    <mxCell id="phase1-label" value="1. Data Collection" style="text;html=1;fontSize=11;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#E65100;" vertex="1" parent="1">
      <mxGeometry x="20" y="45" width="150" height="20" as="geometry"/>
    </mxCell>

    <!-- Customs API -->
    <mxCell id="customs" value="관세청 OpenAPI&lt;br&gt;&lt;font style='font-size:9px;color:#666;'&gt;수출 데이터 (월별)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="70" width="130" height="45" as="geometry"/>
    </mxCell>

    <!-- DataUpdater -->
    <mxCell id="updater" value="DataUpdater Lambda&lt;br&gt;&lt;font style='font-size:9px;color:#666;'&gt;매월 20일 자동 실행&lt;br&gt;Docker · 900s / 2GB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="210" y="65" width="150" height="55" as="geometry"/>
    </mxCell>

    <!-- S3 Data -->
    <mxCell id="s3data" value="S3 Data Bucket&lt;br&gt;&lt;font style='font-size:9px;color:#666;'&gt;merged_signals.csv&lt;br&gt;export_by_sector.csv&lt;br&gt;kospi_real.csv&lt;br&gt;sector_mapping.csv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="420" y="50" width="150" height="85" as="geometry"/>
    </mxCell>

    <!-- Edges phase 1 -->
    <mxCell id="e1" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="customs" target="updater">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" style="endArrow=classic;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="updater" target="s3data">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2-label" value="CSV 저장" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;fontColor=#666;" vertex="1" parent="1">
      <mxGeometry x="370" y="68" width="50" height="15" as="geometry"/>
    </mxCell>

    <!-- Phase 2: Processing -->
    <mxCell id="phase2-label" value="2. Signal Processing" style="text;html=1;fontSize=11;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#E65100;" vertex="1" parent="1">
      <mxGeometry x="20" y="150" width="150" height="20" as="geometry"/>
    </mxCell>

    <!-- MLPredictor -->
    <mxCell id="mlpred" value="MLPredictor&lt;br&gt;&lt;font style='font-size:9px;color:#666;'&gt;Lambda Cold Start 시 로드&lt;br&gt;ARIMA(1,2,1) 예측&lt;br&gt;Surprise Z-Score 산출&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="120" y="175" width="160" height="65" as="geometry"/>
    </mxCell>

    <!-- Signal Generator -->
    <mxCell id="siggen" value="SignalGenerator&lt;br&gt;&lt;font style='font-size:9px;color:#666;'&gt;5-Factor 시그널&lt;br&gt;BUY / HOLD / SELL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="180" width="140" height="55" as="geometry"/>
    </mxCell>

    <!-- S3 to MLPredictor -->
    <mxCell id="e3" style="endArrow=classic;strokeColor=#F9A825;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3data" target="mlpred">
      <mxGeometry relative="1" as="geometry">
